# Secrets — never commit these. Configure them in Streamlit Cloud instead:
# share.streamlit.io -> your app -> Settings -> Secrets
.streamlit/secrets.toml
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# OS
.DS_Store

# migration working file — contains full customer data, never commit
db/migration_payload.json

# local-only secrets (Neon, etc) — never committed
.env.local

# Next.js / node (the web/ front end)
node_modules/
web/.next/
web/out/
web/.vercel/
next-env.d.ts
*.tsbuildinfo
